<div class="album-item-gallery">
  <template id="template">
    <a href="" data-pswp-width="" data-pswp-height="" target="_blank" class="album-item">
      <img src="" alt="" loading="lazy" class="image" />
    </a>
  </template>
</div>

<style>
  .album-item-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    min-height: 50vh;
    padding: 0;
  }

  .album-item {
    aspect-ratio: 1 / 1;

    .image {
      object-fit: cover;
      height: 100%;
      width: 100%;
    }
  }

  @media (min-width: 600px) {
    .album-item-gallery {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>

<script>
  import "../_assets/photoswipe.min.css";
  import PhotoSwipeLightbox from "../_assets/photoswipe-lightbox.esm.min.js";
  import PhotoSwipe from "../_assets/photoswipe.esm.min.js";
  import { ENDPOINT_MEDIA_PATH, ENDPOINT_LIST } from "../_config/endpoints";
  import { fetchFileList } from "../_scripts/fetchFileList";

  const GALLERY_PATH = "青年キャンプ 2025/photo-gallery/";
  const ENDPOINT = `${ENDPOINT_MEDIA_PATH}${GALLERY_PATH.split("/").map(encodeURIComponent).join("/")}`;

  (async () => {
    const template = document.getElementById("template") as HTMLTemplateElement;
    const div = document.querySelector(".album-item-gallery") as HTMLDivElement;
    const fragment = document.createDocumentFragment();

    try {
      const res = await fetchFileList(GALLERY_PATH, ENDPOINT_LIST);

      if (res.status !== "success") {
        console.error("fetchFileList error:", res.message);
        return;
      }

      const files = res.list.filter((item) => item.type === "file").reverse();

      // Server stores thumbnails at 50% of original size; multiply back for PhotoSwipe dimensions.
      const THUMB_SCALE = 2;
      const loadPromises: Promise<void>[] = [];

      for (const file of files) {
        const clone = template.content.cloneNode(true) as DocumentFragment;
        const a = clone.querySelector(".album-item") as HTMLAnchorElement;
        const image = clone.querySelector(".image") as HTMLImageElement;

        const encoded = encodeURIComponent(file.name);
        const promise = new Promise<void>((resolve) => {
          image.onload = () => {
            a.href = `${ENDPOINT}${encoded}`;
            a.dataset.pswpWidth = `${image.naturalWidth * THUMB_SCALE}`;
            a.dataset.pswpHeight = `${image.naturalHeight * THUMB_SCALE}`;
            resolve();
          };
          image.onerror = () => {
            a.remove();
            resolve();
          };
          image.src = `${ENDPOINT}thumb/${encoded}`;
        });
        loadPromises.push(promise);

        fragment.appendChild(clone);
      }

      div.appendChild(fragment);
      await Promise.all(loadPromises);

      const lightbox = new PhotoSwipeLightbox({
        gallery: ".album-item-gallery",
        children: ".album-item",
        pswpModule: PhotoSwipe,
      });

      lightbox.init();
    } catch (err) {
      console.error("Unexpected error in createAlbum:", err);
    }
  })();
</script>
