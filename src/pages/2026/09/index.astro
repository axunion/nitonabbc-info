---
import MapFrame from "@/components/MapFrame.astro";
import Layout from "@/layouts/Layout.astro";
import "./_styles/variables.css";
import hero from "./_assets/hero.webp";
import Bracket from "./_components/Bracket.astro";
import ButtonLink from "./_components/ButtonLink.astro";
import H2 from "./_components/H2.astro";
import H3 from "./_components/H3.astro";
import H4 from "./_components/H4.astro";
import QAList from "./_components/QAList.astro";
import Sprig from "./_components/Sprig.astro";
import Summary from "./_components/Summary.astro";
import TimeTable from "./_components/TimeTable.astro";

const overview = {
  title: "京葉地区青年キャンプ 2026",
  theme: "喜望あふれて！",
  themeVerse: "ローマ人への手紙 15:13",
};

const summaryItems = [
  {
    icon: "mdi:calendar-month-outline",
    label: "日程",
    lines: ["2026年9月20日(日)", "9月22日(火)"],
  },
  {
    icon: "mdi:house-city",
    label: "会場",
    text: "BumB 東京スポーツ文化館",
    detail: "東京都江東区夢の島2-1-3",
  },
  {
    icon: "mdi:lectern",
    label: "講師",
    text: "井口拓志牧師",
    detail: "立川聖書バプテスト教会",
  },
  {
    icon: "mdi:money",
    label: "参加費",
    lines: ["一般 ¥20,000", "22歳以下 ¥18,000"],
  },
];

const odaibaSchedule = {
  caption: "①お台場観光",
  rows: [
    { th: "12:30", td: "新木場駅 集合" },
    { th: "12:40", td: "東京テレポート駅" },
    { th: "12:50", td: "デックス東京ビーチ（自由・各自昼食）" },
    { th: "15:00", td: "ゆりかもめ台場駅" },
    { th: "15:20", td: "テレコムセンター展望室（500円）" },
    { th: "17:00", td: "新木場駅 到着" },
  ],
};

const careerHistory = [
  { th: "1969年1月", td: "東京にて誕生" },
  { th: "小学4年生", td: "滝山教会で救いを受ける" },
  { th: "20歳", td: "献身、神学校へ" },
  { th: "1993年（24歳）", td: "神学校卒業後、滝山教会にて伝道師に就任" },
  { th: "1997年", td: "立川教会の伝道師に就任" },
  { th: "2003年", td: "教会独立・牧師に就任" },
  { th: "2011年", td: "新会堂を献堂" },
];
---

<Layout title={overview.title}>
  <header class="header" style={{ backgroundImage: `url(${hero.src})` }}>
    <div class="hero-content">
      <p class="eyebrow">KEIYO YOUTH CAMP 2026</p>
      <h1 class="h1">{overview.theme}</h1>
      <div class="ornament"><Sprig /></div>
      <p class="verse">- {overview.themeVerse} -</p>
    </div>
  </header>

  <main class="main">
    <section class="section">
      <p>主の御名を賛美いたします。</p>
      <p>2026年、京葉地区青年キャンプを開催する運びとなりましたことをご案内申し上げます。</p>
      <p>
        今回のテーマは「喜望あふれて！」。神様が与えてくださる希望と喜びを、ともに見つめる時としたいと願っています。皆様のご参加を心よりお待ち申し上げております。
      </p>
    </section>

    <section class="section">
      <H2>概要</H2>
      <Summary items={summaryItems} />
    </section>

    <section class="section">
      <H2>講師紹介</H2>

      <H3 icon="mdi:account-tie">井口拓志牧師</H3>
      <Bracket>
        今回の集いで皆さんと分かち合いたいテーマは、"喜望"（希望＋喜び）です。「希望を持ちなさい」と言われても、先が見えない時があります。「喜びなさい」と言われても、心から喜べない時があります。聖書が語る希望は、「きっとうまくいく」という願望ではありません。神様に根差した、あふれ出る希望です。また聖書が語る喜びは、嫌なことがなくなったから生まれるものでも、自分で作り出すものでもありません。神様ご自身が与え、満たしてくださる喜びです。ローマ15:13から、神様が与えてくださる"喜望"を一緒に見つめてみませんか？
      </Bracket>

      <H4>プロフィール</H4>
      <QAList
        list={[
          { q: "所属", a: "立川聖書バプテスト教会 牧師" },
          { q: "家族", a: "妻と2男3女の7人家族" },
          { q: "趣味", a: "韓国ドラマ、カフェ" },
        ]}
      />

      <H4>略歴</H4>
      <table class="profile-table">
        {
          careerHistory.map(({ th, td }) => (
            <tr>
              <th class="profile-th">{th}</th>
              <td>{td}</td>
            </tr>
          ))
        }
      </table>
    </section>

    <section class="section">
      <H2>プログラム</H2>

      <H3 icon="mdi:calendar-range">日程について</H3>
      <p>
        2026年9月20日（日）から22日（火）まで、2泊3日の日程で開催いたします。詳しいタイムテーブルは、決まり次第あらためてご案内いたします。
      </p>

      <H3 icon="mdi:run">レクリエーション</H3>
      <p>2日目の午後は、以下の3つから選んでご参加いただけます。</p>

      <H4>①お台場観光</H4>
      <TimeTable {...odaibaSchedule} />
      <p>
        参加費の目安は1,500円＋昼食代（交通費1,000円、テレコムセンター入場料500円）です。テレコムセンター入場料のみ当日集金し、交通費は乗車の都度お支払いください。昼食は各自でご用意ください。
      </p>

      <H4>②夢の島熱帯植物館</H4>
      <p>
        施設敷地内にある夢の島熱帯植物館で植物鑑賞をします。館内のカフェでゆっくりくつろぐこともできます。参加費250円（入園料）。昼食は施設でお召し上がりいただきます。
      </p>

      <H4>③映画</H4>
      <p>
        映画鑑賞（内容は当日のお楽しみ）をしてまったり過ごします。参加費は無料です。昼食は施設でお召し上がりいただきます。
      </p>

      <H3 icon="mdi:account-group">分科会</H3>
      <p>分科会では4つのテーマをご用意しております。ご関心のあるテーマを選択の上、ご参加ください。</p>

      <H4>
        結婚
        <span class="workshop-speaker">講師：安藤修司師</span>
      </H4>
      <p>
        結婚に乗り気でない方は結婚の祝福を知ることができます。結婚を祈っている方は祝福される家庭の築き方を学べます。相手探しに悩んでいる方にも多くのヒントが与えられる分科会です。
      </p>

      <H4>
        次世代との関り
        <span class="workshop-speaker">講師：齋藤光彦師</span>
      </H4>
      <p>
        青年でいられるのはあっという間です。この限られた時間を次世代のために用いましょう。若い世代とどう関わったらよいか、どうしたらよい証しができるのかを学びます。
      </p>

      <H4>
        熱心さの持続
        <span class="workshop-speaker">講師：所炎師</span>
      </H4>
      <p>
        キャンプで燃えても決心が続かない方、信仰生活に疲れを感じる方、教会生活が形式的になっている気がする方などにおすすめの分科会です。いつも熱心に主に仕えていくために大切なことを学びます。
      </p>

      <H4>
        宣教
        <span class="workshop-speaker">講師：佐藤一彦師</span>
      </H4>
      <p>
        イエス様は天に帰られる前に、弟子達に世界宣教を命じられました。信仰者にとって世界宣教は重要な使命であるにもかかわらず、身近に感じられないこともあります。宣教をもっと身近なものにしていくために、JBBF海外宣教委員長が語ります。
      </p>
    </section>

    <section class="section">
      <H2>お申し込み</H2>

      <H3 icon="mdi:file-document-edit-outline">お申し込み方法</H3>
      <p>下記のリンクより、Webフォームからお申し込みください。</p>
      <ButtonLink href="https://form.nitonabbc.org/2026/09/apply/">
        参加申し込み
      </ButtonLink>

      <H3 icon="mdi:calendar-clock">お申し込み期限</H3>
      <div class="deadline">2026年8月9日（日）まで</div>
    </section>

    <section class="section">
      <H2>その他の情報</H2>

      <H3 icon="mdi:bag-suitcase">持ち物</H3>
      <p>
        聖書、筆記用具、着替えなど、宿泊に必要なものをご持参ください。レクリエーションで「①お台場観光」を選ばれる方は、歩きやすい靴をご用意ください。
      </p>
      <p>
        施設にはWiFi、ドライヤー、ナイトウェア、バスタオル、フェイスタオル、歯ブラシ、ボディーソープ、シャンプー、リンスをご用意いただいております。
      </p>

      <H3 icon="mdi:medical-bag">アレルギー対応</H3>
      <p>
        食物アレルギーによる食事制限等がございます方は、お申し込み時の備考欄にその旨をご記入ください。
      </p>

      <H3 icon="mdi:map-marker">アクセス</H3>
      <MapFrame
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12968.426070133624!2d139.8299139!3d35.6497472!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6018883c5dbb0623%3A0xc26f94a6ff247d1a!2zQnVtQiDmnbHkuqzjgrnjg53jg7zjg4TmlofljJbppKg!5e0!3m2!1sja!2sjp!4v1718553573811!5m2!1sja!2sjp"
        title="BumB 東京スポーツ文化館へのアクセスマップ"
      />

      <H3 icon="mdi:car">駐車場について</H3>
      <p>
        施設には専用駐車場がありません。お車でお越しの際は「夢の島公園第1駐車場（南）」をご利用いただけます。料金等の詳細は
        <a
          href="https://www.tokyo-park.or.jp/park/yumenoshima/#traffic"
          target="_blank"
          rel="noopener noreferrer"
          class="link"
        >
          公式の案内
        </a>
        をご確認ください。
      </p>

      <H3 icon="mdi:help-circle-outline">お問い合わせ</H3>
      <p>
        ご質問やご不明な点がございましたら、LINEオープンチャットからお気軽にお問い合わせください。下記のリンクからご参加いただけます。
      </p>
      <p><strong class="strong">🔐 参加コード: 0333</strong></p>
      <ButtonLink href="https://line.me/ti/g2/WYr1mnNiAIT7mb_pyn2T5JoEMcZXyGUPchf7IA">
        オープンチャット
      </ButtonLink>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-ornament"><Sprig /></div>
    <small>京葉地区合同青年会</small>
  </footer>
</Layout>

<style>
  .header {
    align-items: center;
    background: var(--text-1) no-repeat center center / cover;
    display: flex;
    justify-content: center;
    min-height: 100svh;
    position: relative;
  }

  .header::before {
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 50%,
        color-mix(in srgb, var(--gray-9) 62%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        color-mix(in srgb, var(--green-8) 12%, transparent),
        color-mix(in srgb, var(--green-8) 12%, transparent)
      );
    content: "";
    inset: 0;
    position: absolute;
  }

  .hero-content {
    padding: 2em;
    position: relative;
    text-align: center;
  }

  .eyebrow {
    color: var(--surface);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    margin: 0 0 1.25em;
    opacity: 0.9;
    text-shadow: 0 1px 4px color-mix(in srgb, var(--gray-9) 80%, transparent);
  }

  .h1 {
    color: var(--surface);
    font-size: 175%;
    font-weight: bold;
    letter-spacing: 0.05em;
    margin: 0;
    text-shadow:
      0 1px 3px color-mix(in srgb, var(--gray-9) 85%, transparent),
      0 4px 20px color-mix(in srgb, var(--gray-9) 60%, transparent);
  }

  .ornament {
    color: var(--green-2);
    margin: 1.25em auto;
  }

  .verse {
    color: var(--surface);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    margin: 0;
    opacity: 0.9;
    text-shadow: 0 1px 4px color-mix(in srgb, var(--gray-9) 80%, transparent);
  }

  .main {
    margin: auto;
    max-width: 600px;
    padding: 0 1.5em;
  }

  .section {
    margin: 15vh 0;
  }

  .profile-table {
    border-collapse: collapse;
    font-size: 90%;
    margin: 1em 0;
    table-layout: fixed;
  }

  .profile-th {
    color: var(--text-2);
    font-weight: normal;
    padding: 0 1em 0.5em 0;
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }

  .workshop-speaker {
    color: var(--text-2);
    display: block;
    font-size: 70%;
    font-weight: normal;
    margin: 0.3em 0 0;
  }

  .deadline {
    background: var(--red-8);
    border-radius: 2px;
    color: var(--surface);
    font-size: 115%;
    font-weight: bold;
    letter-spacing: 0.08em;
    margin: 1em 0;
    padding: 1em;
    text-align: center;
  }

  .strong {
    color: var(--brand);
    font-size: 120%;
    letter-spacing: 0.05em;
  }

  .link {
    color: var(--brand);
    text-decoration: underline;
  }

  .footer {
    padding: 12vh 0 5vh;
    text-align: center;
  }

  .footer-ornament {
    color: var(--brand);
    margin: 0 auto 1.25em;
    opacity: 0.6;
  }
</style>
